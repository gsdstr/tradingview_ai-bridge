{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MCP Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "tsx",
      "program": "${workspaceFolder}/apps/mcp/src/index.ts",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug CLI (tv)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "./node_modules/.bin/tsx ./apps/cli/src/index.ts ${input:cliArgs}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug: Attach to Running Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug Tests (e2e)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@repo/e2e", "test"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug CLI — TV_DEBUG mode (renderer step-through)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "sh",
      // to pass cliArgs without escaping
      "runtimeArgs": [
        "-c",
        "TV_DEBUG=1 ./node_modules/.bin/tsx ./apps/cli/src/index.ts ${input:cliArgs}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug Harness Script",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "tsx",
      "program": "${workspaceFolder}/${input:harnessFile}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "env": {
        "NODE_ENV": "development",
        "TV_DEBUG": "1"
      }
    }
  ],
  "inputs": [
    {
      "id": "cliArgs",
      "type": "promptString",
      "description": "CLI arguments (e.g. watchlist get)",
      "default": "indicator list"
    },
    {
      "id": "harnessFile",
      "type": "promptString",
      "description": "Harness script path relative to workspace (e.g. apps/e2e/src/chart.test.ts)",
      "default": "apps/e2e/src/chart.test.ts"
    }
  ]
}
